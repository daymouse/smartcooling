# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=
# Publishable (anon) key. NEVER put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: JWT of an authenticated user, used to authorize the private Realtime channel.
# Prefer signing in with Supabase Auth (see docs/REALTIME.md). Leave empty if unused.
VITE_SUPABASE_REALTIME_JWT=
# Seconds without a reading before the device is shown as Offline
VITE_DEVICE_OFFLINE_TIMEOUT_SECONDS=10
